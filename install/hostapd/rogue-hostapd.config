# Rogue hostapd build-config overlay.
#
# The build starts from upstream hostapd/defconfig and then ensures each option
# below is set (any matching commented/!=y line is replaced). This keeps us
# resilient to defconfig changes across hostap releases while guaranteeing the
# capabilities rogue depends on.

# nl80211 driver (the AP driver rogue uses)
CONFIG_DRIVER_NL80211=y

# PHY generations
CONFIG_IEEE80211N=y        # HT  (Wi-Fi 4)  [no-op on releases where HT is always built]
CONFIG_IEEE80211AC=y       # VHT (Wi-Fi 5)
CONFIG_IEEE80211AX=y       # HE  (Wi-Fi 6/6E)
CONFIG_IEEE80211BE=y       # EHT (Wi-Fi 7)

# Automatic Channel Selection (used when a channel is not pinned)
CONFIG_ACS=y

# Legacy WEP AP support (rogue exposes --auth wep)
CONFIG_WEP=y

# WPA3 / Enhanced Open building blocks (prep for the WPA3/OWE/PMF work; needed
# for 6 GHz and Wi-Fi 7, which mandate PMF and forbid open/WPA2).
CONFIG_SAE=y               # WPA3-Personal (SAE)
CONFIG_OWE=y               # Enhanced Open (OWE)
