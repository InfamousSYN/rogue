diff --git a/src/ap/rogue.h b/src/ap/rogue.h
new file mode 100644
index 0000000..d899dd3
--- /dev/null
+++ b/src/ap/rogue.h
@@ -0,0 +1,10 @@
+#ifndef ROGUE_H
+#define ROGUE_H
+
+/* Rogue toolkit additions to hostapd.
+ * rogue_karma: when set (-k), the AP answers probe requests for any SSID
+ * (gratuitous probe responses) and accepts associations regardless of the
+ * SSID advertised, i.e. KARMA-style behaviour. */
+extern int rogue_karma;
+
+#endif /* ROGUE_H */
