 #endif /* CONFIG_DPP */
 
 	for (;;) {
-		c = getopt(argc, argv, "b:Bde:f:hi:KP:sSTtu:vg:G:q");
+		c = getopt(argc, argv, "b:Bde:f:hi:kKP:sSTtu:vg:G:q");
 		if (c < 0)
 			break;
 		switch (c) {
@@ -830,6 +831,9 @@ int main(int argc, char *argv[])
 		case 'f':
 			log_file = optarg;
